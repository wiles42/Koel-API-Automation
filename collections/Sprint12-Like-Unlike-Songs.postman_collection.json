    {
      "name": "Like multiple songs",
      "item": [
        {
          "name": "Like multiple songs",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();\n\n// Verify 200 OK\npm.test(\"Status code is 200 OK\", function () {\n    pm.response.to.have.status(200);\n});\n\n// Verify response is an array\npm.test(\"Response contains an array of songs\", function () {\n    pm.expect(response).to.be.an(\"array\").that.is.not.empty;\n});\n\n// Verify multiple songs are returned\npm.test(\"Multiple songs are returned\", function () {\n    pm.expect(response.length).to.be.greaterThan(1);\n});\n\n// Verify each song has a valid song_id\npm.test(\"All songs have valid song IDs\", function () {\n    response.forEach(function (item) {\n        pm.expect(item.song_id).to.be.a(\"string\").and.not.empty;\n    });\n});\n\n// Verify all songs are liked\npm.test(\"All songs are liked\", function () {\n    response.forEach(function (item) {\n        pm.expect(item.liked).to.eql(true);\n    });\n});\n\n// Verify play_count is valid\npm.test(\"All songs have valid play counts\", function () {\n    response.forEach(function (item) {\n        pm.expect(item.play_count).to.be.a(\"number\");\n        pm.expect(item.play_count).to.be.at.least(0);\n    });\n});\n\n// Verify song details are returned\npm.test(\"All songs contain valid song details\", function () {\n    response.forEach(function (item) {\n        pm.expect(item.song).to.be.an(\"object\");\n        pm.expect(item.song.title).to.be.a(\"string\").and.not.empty;\n        pm.expect(item.song.id).to.eql(item.song_id);\n    });\n});"
                ]
              }
            }
          ],
