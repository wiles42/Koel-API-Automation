          "name": "Like Song",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();\n\n// Verify 200 OK\npm.test(\"Status code is 200 OK\", function () {\n    pm.response.to.have.status(200);\n});\n\n// Verify song_id is returned\npm.test(\"Song ID is returned\", function () {\n    pm.expect(response.song_id).to.be.a(\"string\").and.not.empty;\n});\n\n// Verify song is liked\npm.test(\"Song liked is true\", function () {\n    pm.expect(response.liked).to.eql(true);\n});\n\n// Verify play_count is a valid number\npm.test(\"Play count is a valid number\", function () {\n    pm.expect(response.play_count).to.be.a(\"number\");\n    pm.expect(response.play_count).to.be.at.least(0);\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\"song\": \"da98f9eb65971e2d76d9ec3640bab317\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
